generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  type     String
  managers Manager[]
  staffs   Staff[]

  @@map("users")
}

model Manager {
  id           Int                  @id @default(autoincrement())
  user_id      Int
  name         String
  phone        String
  nif          String
  user         User                 @relation(fields: [user_id], references: [id])
  condominiums CondominiumManager[]

  @@map("managers")
}

model Condominium {
  id       Int                  @id @default(autoincrement())
  name     String
  address  String
  city     String
  state    String
  zip      String
  country  String
  managers CondominiumManager[]
  services Service[]

  @@map("condominiums")
}

model CondominiumManager {
  id             Int         @id @default(autoincrement())
  condominium_id Int
  manager_id     Int
  condominium    Condominium @relation(fields: [condominium_id], references: [id])
  manager        Manager     @relation(fields: [manager_id], references: [id])

  @@unique([condominium_id, manager_id])
  @@map("condominium_managers")
}

model Staff {
  id       Int          @id @default(autoincrement())
  user_id  Int
  name     String
  phone    String
  nif      String
  user     User         @relation(fields: [user_id], references: [id])
  skills   StaffSkill[]
  services Service[]

  @@map("staff")
}

model Skill {
  id     Int          @id @default(autoincrement())
  name   String
  staffs StaffSkill[]

  @@map("skills")
}

model StaffSkill {
  id       Int   @id @default(autoincrement())
  staff_id Int
  skill_id Int
  staff    Staff @relation(fields: [staff_id], references: [id])
  skill    Skill @relation(fields: [skill_id], references: [id])

  @@unique([staff_id, skill_id])
  @@map("staff_skills")
}

model Service {
  id             String        @id
  condominium_id Int
  staff_id       Int
  description    String
  start_date     DateTime
  end_date       DateTime
  status         String
  created_at     DateTime      @default(now())
  updated_at     DateTime      @default(now())
  price          Decimal
  condominium    Condominium   @relation(fields: [condominium_id], references: [id])
  staff          Staff         @relation(fields: [staff_id], references: [id])
  photos         PhotoService[]
  check_lists    CheckList[]

  @@map("services")
}

model PhotoService {
  id         Int      @id @default(autoincrement())
  service_id String
  photo_url  String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  service    Service  @relation(fields: [service_id], references: [id])

  @@map("photo_services")
}

model CheckList {
  id         Int             @id @default(autoincrement())
  service_id String
  description String
  created_at DateTime        @default(now())
  updated_at DateTime        @default(now())
  service    Service         @relation(fields: [service_id], references: [id])
  items      CheckListItem[]

  @@map("check_lists")
}

model CheckListItem {
  id            Int       @id @default(autoincrement())
  check_list_id Int
  description   String
  completed     Boolean
  check_list    CheckList @relation(fields: [check_list_id], references: [id])

  @@map("check_list_items")
}
