generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  type     String
  managers Manager[]

  @@map("users")
}

model Manager {
  id      Int    @id @default(autoincrement())
  user_id Int
  name    String
  phone   String
  nif     String
  user    User   @relation(fields: [user_id], references: [id])

  @@map("managers")
}
